# Copia este archivo como .env.local para «vercel dev», o crea estas variables en
# Vercel › Project › Settings › Environment Variables. NUNCA subas valores reales a GitHub.

# ── Conexión de escritura con la hoja: OPCIÓN A, Apps Script (recomendada) ──
# URL de la implementación «Aplicación web» del script apps-script/Code.gs (termina en /exec).
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Clave compartida: debe ser IGUAL a la propiedad APP_SECRET del Apps Script (mínimo 16 caracteres).
APPS_SCRIPT_SECRET=

# ── OPCIÓN B, cuenta de servicio de Google Cloud (solo si no usas Apps Script) ──
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# MAQUINAS_SPREADSHEET_ID=1PuXWlmC_ZQOBHYAk-OT1Z73gAqF8FtGctp-CYoqPsDk
# MAQUINAS_SOURCE_TAB=Hoja 1

# ── Sesiones y usuarios (necesarios para agregar y editar) ──
# Cadena aleatoria de al menos 32 caracteres.
SESSION_SECRET=
# Lista JSON de usuarios. Roles: editor (lee y escribe) o lector (solo lee).
# Genera cada hash con: powershell -ExecutionPolicy Bypass -File scripts/hash-password.ps1
APP_USERS=[{"user":"usuario","role":"editor","hash":"pbkdf2$sha256$210000$SAL$HASH"}]

# true = también la consulta de máquinas exige iniciar sesión.
READ_REQUIRES_LOGIN=false
